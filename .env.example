# Copy to .env and fill in. Never commit .env.

# Google AI Studio key for Gemini drafting.
GEMINI_API_KEY=
# Model id; check https://aistudio.google.com/docs for current names.
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is busy (503) or times out.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3-flash-preview,gemini-3.7-flash
# Interactions API revision header (from the official docs, 2026-05-20).
GEMINI_API_REVISION=2026-05-20

# Gemini can think for a while: its own read timeout (seconds).
GEMINI_TIMEOUT_SECONDS=90

# HTTP behaviour for all external calls.
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Autoposting (python -m bayesly autopost --live). See docs/autopost-setup.md.
# Without --live nothing is published, whatever is filled in here.
# ---------------------------------------------------------------------------
PLATFORMS=threads,instagram,x
POSTS_PER_RUN=1
# Vertical video (needs ffmpeg): networks that get the video instead of the carousel; 'none' = off
VIDEO_PLATFORMS=instagram,x
VIDEO_VOICE=1
# Free stock footage (pexels.com/api), used ONLY when the source has no photo and no capturable page
PEXELS_API_KEY=
# Kill switch: 1 = publish nothing (also: `python -m bayesly pause`, or /pause in Telegram)
BAYESLY_PAUSED=0

# Threads API (graph.threads.net)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Instagram API with Unified login (graph.facebook.com), system-user token, professional account.
# INSTAGRAM_USER_ID = id from GET /me/assigned_instagram_accounts
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# X API, OAuth 1.0a user context (pay-per-use; posts are link-free: ~$0.015 each)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_HANDLE=bayesly_ai
X_MAX_IMAGES=1

# Public image hosting: a PUBLIC GitHub repo that holds only slide JPEGs
MEDIA_GITHUB_REPO=
MEDIA_GITHUB_TOKEN=
MEDIA_GITHUB_BRANCH=main

# Owner control channel: held posts + /pause /resume /status
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: where drafts/state live (CI uses ci-state/queue and ci-state)
# OUT_DIR=
# STATE_DIR=

# Later
# BEEHIIV_API_KEY=
