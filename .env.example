# Copy to .env and fill in. Never commit .env.

# Google AI Studio key for Gemini drafting.
GEMINI_API_KEY=
# Model id; check https://aistudio.google.com/docs for current names.
GEMINI_MODEL=gemini-3.8-flash
# Interactions API revision header (from the official docs, 2026-05-20).
GEMINI_API_REVISION=2026-05-20

# HTTP behaviour for all external calls.
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Phase 2+ only (not used yet). Leave empty.
# THREADS_ACCESS_TOKEN=
# X_API_KEY=
# BEEHIIV_API_KEY=
